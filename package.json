{
  "name": "shoot-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "dev:seed": "NEXT_PUBLIC_DEV_SEED=1 next dev",
    "postinstall": "patch-package",
    "build:ios": "next build && cap sync ios",
    "open:ios": "cap open ios",
    "assets:ios": "capacitor-assets generate --ios --assetPath resources --iconBackgroundColor \"#FBF8F3\" --iconBackgroundColorDark \"#FBF8F3\" --splashBackgroundColor \"#FBF8F3\" --splashBackgroundColorDark \"#FBF8F3\""
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/status-bar": "^8.0.4",
    "dexie": "^4.4.6",
    "html-to-image": "^1.11.13",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "patch-package": "^8.0.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
